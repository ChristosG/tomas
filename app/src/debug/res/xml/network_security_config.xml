<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. The release APK has no network security config at all, so the platform default
  applies and plain HTTP is refused: the sync server is meant to sit behind the family's own TLS
  proxy, and a token sent in the clear is a token given away.

  The two addresses below are the development machine as seen from an emulator (10.0.2.2) and from
  the device itself (127.0.0.1). They exist so the instrumented sync test can talk to a Node server
  started on this machine; they mean nothing on a real phone.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
