<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: points the app at @xml/network_security_config so the instrumented sync test can
  reach a Node server on the development machine over plain HTTP. The release manifest carries no
  such attribute, so the release APK keeps the platform's own rule and refuses cleartext outright.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
